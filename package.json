{
  "name": "hocfam",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "android:build": "expo run:android",
    "eas:configure": "eas build:configure",
    "build:android:internal": "eas build --platform android --profile internal-android",
    "build:android:dev:online": "eas build --platform android --profile development-android-online",
    "build:android:preview:online": "eas build --platform android --profile preview-android-online",
    "build:android:prod:online": "eas build --platform android --profile production-android-online",
    "build:android:download": "eas build --platform android --profile production-android-online",
    "build:android:all:online": "npm run build:android:dev:online && npm run build:android:preview:online && npm run build:android:prod:online",
    "build:list": "eas build:list --platform android --limit 5",
    "build:list:latest": "eas build:list --platform android --limit 1 --non-interactive",
    "build:ios:internal": "eas build --platform ios --profile internal-ios",
    "build:all:internal": "eas build --platform all --profile preview",
    "update:preview": "eas update --channel preview --auto",
    "update:production": "eas update --channel production --auto",
    "publish:update": "eas update --channel production --auto",
    "size:assets": "powershell -NoProfile -Command \"Get-ChildItem -Recurse assets -File | Sort-Object Length -Descending | Select-Object -First 20 @{Name='SizeMB';Expression={[math]::Round($_.Length/1MB,2)}}, FullName | Format-Table -AutoSize\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-native-picker/picker": "^2.11.1",
    "@react-navigation/bottom-tabs": "^7.10.1",
    "@react-navigation/drawer": "^7.7.13",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.10.1",
    "axios": "^1.13.2",
    "expo": "~54.0.33",
    "expo-asset": "^55.0.8",
    "expo-audio": "~1.1.1",
    "expo-av": "~16.0.8",
    "expo-build-properties": "^55.0.9",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "^15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "^19.0.21",
    "expo-font": "^14.0.11",
    "expo-image-picker": "^17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "^0.32.16",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "^31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "^6.0.9",
    "expo-updates": "~29.0.16",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-paper": "^5.14.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "expo-module-scripts": "^55.0.2",
    "typescript": "~5.9.2"
  },
  "private": true
}