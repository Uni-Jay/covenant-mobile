{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "distribution": "internal",
      "environment": "production",
      "channel": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a",
        "ORG_GRADLE_PROJECT_hermesFlagBuildType": "release"
      }
    },
    "internal-android": {
      "distribution": "internal",
      "environment": "production",
      "channel": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a",
        "ORG_GRADLE_PROJECT_hermesFlagBuildType": "release"
      }
    },
    "store": {
      "distribution": "store",
      "environment": "production",
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}